NODE_ENV=development
PORT=3333

# Postgres — deve bater com docker-compose.yml
DATABASE_URL="postgresql://campo_em_dia:campo_em_dia@localhost:5432/campo_em_dia?schema=public"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-caracteres"
JWT_EXPIRES_IN=8h

# Object storage (MinIO local — troque por S3/R2 em produção)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION=us-east-1
STORAGE_BUCKET=campo-em-dia
STORAGE_ACCESS_KEY=campo_em_dia
STORAGE_SECRET_KEY=campo_em_dia_secret
STORAGE_FORCE_PATH_STYLE=true

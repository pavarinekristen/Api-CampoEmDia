// Campo em Dia — schema inicial (MVP)
//
// Estratégia de multitenancy: banco único / schema único, discriminador `tenantId`
// em toda tabela de negócio. Row-Level Security (RLS) é habilitada via migração
// SQL adicional (ver prisma/migrations/xxx_enable_rls) como segunda camada de
// isolamento, além do filtro aplicado na camada de aplicação (AsyncLocalStorage).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY & ACCESS
// ─────────────────────────────────────────────────────────────────────────

enum TenantType {
  AUTONOMO
  EMPRESA
}

enum UserRole {
  PROFISSIONAL_PROPRIETARIO
  GESTOR_EQUIPE
  TECNICO_CAMPO
  SUPERVISOR_TECNICO
  CONSULTOR_PARCEIRO
}

model Tenant {
  id        String     @id @default(uuid())
  type      TenantType
  name      String
  document  String?    // CPF/CNPJ, opcional no cadastro inicial
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users      User[]
  clients    Client[]
  properties Property[]
  visits     Visit[]
  evidences  Evidence[]
  tasks      TaskItem[]
  reports    Report[]
  charges    ServiceCharge[]
  auditLogs  AuditLog[]
  customFieldDefinitions CustomFieldDefinition[]
  animals             Animal[]
  lotes               Lote[]
  animalHealthEvents  AnimalHealthEvent[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitsAsProfessional Visit[]    @relation("VisitProfessional")
  tasksAssigned        TaskItem[] @relation("TaskAssignee")
  healthEventsApplied  AnimalHealthEvent[] @relation("HealthEventAppliedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────
// CRM RURAL
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  contact   String?
  notes     String?
  version   Int      @default(1) // concorrência otimista em updates
  deletedAt DateTime? // soft delete — nunca apagar histórico de verdade
  customFields Json? // campos definidos pelo tenant via CustomFieldDefinition
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
  charges    ServiceCharge[]

  @@index([tenantId])
  @@map("clients")
}

model Property {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  name         String
  location     String?
  latitude     Float?
  longitude    Float?
  activities   String?  // atividades desenvolvidas na propriedade
  frequency    String?  // frequência de acompanhamento combinada
  version      Int      @default(1) // concorrência otimista em updates
  deletedAt    DateTime? // soft delete — nunca apagar histórico de verdade
  customFields Json? // campos definidos pelo tenant via CustomFieldDefinition
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  visits  Visit[]
  animals Animal[]
  lotes   Lote[]

  @@index([tenantId])
  @@index([clientId])
  @@map("properties")
}

// ─────────────────────────────────────────────────────────────────────────
// VISITS
// ─────────────────────────────────────────────────────────────────────────

enum VisitType {
  ACOMPANHAMENTO
  EMERGENCIA
  RETORNO
  COLETA
  VACINACAO
  REPRODUCAO
  AVALIACAO_PRODUTIVA
  VISTORIA
  CONSULTORIA
}

enum VisitStatus {
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

model Visit {
  id                String      @id @default(uuid())
  // client_id gerado no dispositivo (offline-first) — chave de idempotência
  // na sincronização, independente do id interno do banco.
  clientGeneratedId String      @unique
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  propertyId        String
  property          Property    @relation(fields: [propertyId], references: [id])
  professionalId    String
  professional      User        @relation("VisitProfessional", fields: [professionalId], references: [id])
  type              VisitType
  status            VisitStatus @default(EM_ANDAMENTO)
  startedAt         DateTime
  endedAt           DateTime?
  summary           String?
  version           Int         @default(1) // optimistic concurrency para sync
  customFields      Json?       // campos definidos pelo tenant via CustomFieldDefinition — só aceito na criação

  evidences    Evidence[]
  tasks        TaskItem[]
  report       Report?
  healthEvents AnimalHealthEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([propertyId])
  @@map("visits")
}

enum EvidenceType {
  TEXTO
  AUDIO
  FOTO
  VIDEO
  DOCUMENTO
}

model Evidence {
  id                String       @id @default(uuid())
  clientGeneratedId String       @unique
  tenantId          String       // denormalizado a partir de Visit — necessário para RLS direta nesta tabela
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  visitId           String
  visit             Visit        @relation(fields: [visitId], references: [id])
  type              EvidenceType
  storageKey        String?      // chave no object storage (S3/MinIO)
  mimeType          String?
  sizeBytes         Int?
  transcriptDraft    String?      // rascunho gerado por IA a partir de áudio
  transcriptReviewed Boolean      @default(false) // confirmação humana obrigatória
  note              String?
  createdAt         DateTime     @default(now())

  @@index([tenantId])
  @@index([visitId])
  @@map("evidences")
}

// ─────────────────────────────────────────────────────────────────────────
// TASKS / ORIENTAÇÕES
// ─────────────────────────────────────────────────────────────────────────

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
  CANCELADA
}

model TaskItem {
  id                String       @id @default(uuid())
  clientGeneratedId String       @unique
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  visitId           String
  visit             Visit        @relation(fields: [visitId], references: [id])
  description       String
  assigneeId        String?
  assignee          User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate           DateTime?
  priority          TaskPriority @default(MEDIA)
  status            TaskStatus   @default(PENDENTE)
  requiresReturnVisit Boolean    @default(false)
  evidenceExpected  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([visitId])
  @@map("tasks")
}

// ─────────────────────────────────────────────────────────────────────────
// REPORTS
// ─────────────────────────────────────────────────────────────────────────

enum ReportStatus {
  PENDENTE
  PROCESSANDO
  PRONTO
  FALHOU
}

model Report {
  id         String       @id @default(uuid())
  tenantId   String       // denormalizado a partir de Visit — necessário para RLS direta nesta tabela
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  visitId    String       @unique
  visit      Visit        @relation(fields: [visitId], references: [id])
  status     ReportStatus @default(PENDENTE)
  storageKey String?      // PDF final no object storage
  sharedUrl  String?      // link assinado usado no WhatsApp
  generatedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([tenantId])

  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────
// BILLING — cobrança simples por serviço (MVP item 11, sem ERP financeiro)
// ─────────────────────────────────────────────────────────────────────────

enum ServiceChargeStatus {
  PENDENTE
  PAGO
  CANCELADO
}

model ServiceCharge {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id])
  description String
  amountCents Int
  status      ServiceChargeStatus @default(PENDENTE)
  dueDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([tenantId])
  @@index([clientId])
  @@map("service_charges")
}

// ─────────────────────────────────────────────────────────────────────────
// AUDIT LOG — obrigatório para toda alteração relevante (MVP item 14)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  entity     String   // ex: "Visit", "Property"
  entityId   String
  action     String   // ex: "CREATE", "UPDATE", "SYNC_CONFLICT_RESOLVED"
  actorId    String?
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// CAMPOS CUSTOMIZÁVEIS — motor genérico reaproveitado por qualquer módulo.
// Cada tenant define seus próprios campos por tipo de cadastro; os valores
// preenchidos ficam na coluna `customFields` (Json) do próprio registro
// (Client/Property/Visit/Animal), validados contra estas definições antes
// de salvar. Ver CustomFieldsValidatorService.
// ─────────────────────────────────────────────────────────────────────────

enum CustomFieldEntityType {
  CLIENT
  PROPERTY
  VISIT
  ANIMAL
}

enum CustomFieldType {
  TEXTO
  NUMERO
  DATA
  SIM_NAO
  LISTA
  LISTA_MULTIPLA
}

model CustomFieldDefinition {
  id         String                @id @default(uuid())
  tenantId   String
  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  entityType CustomFieldEntityType
  key        String                // slug estável, ex: "peso_ao_nascer"
  label      String                // rótulo exibido, ex: "Peso ao nascer (kg)"
  fieldType  CustomFieldType
  options    Json?                 // array de strings — só para LISTA/LISTA_MULTIPLA
  required   Boolean               @default(false)
  order      Int                   @default(0)
  active     Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([tenantId, entityType, key])
  @@index([tenantId, entityType])
  @@map("custom_field_definitions")
}

// ─────────────────────────────────────────────────────────────────────────
// VETERINÁRIA — Animal é o cadastro universal mínimo; tudo o que varia por
// especialidade/profissional vive em `customFields`, não aqui.
// ─────────────────────────────────────────────────────────────────────────

enum AnimalSex {
  MACHO
  FEMEA
}

enum AnimalStatus {
  ATIVO
  VENDIDO
  MORTO
  DESCARTADO
}

model Lote {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animals Animal[]

  @@index([tenantId])
  @@index([propertyId])
  @@map("lotes")
}

model Animal {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  propertyId   String
  property     Property     @relation(fields: [propertyId], references: [id])
  loteId       String?
  lote         Lote?        @relation(fields: [loteId], references: [id])
  identifier   String       // brinco/número de identificação
  name         String?
  species      String       // livre (bovino, equino, caprino...) — não vale travar em enum
  breed        String?
  sex          AnimalSex?
  birthDate    DateTime?
  status       AnimalStatus @default(ATIVO)
  statusReason String?      // motivo da baixa (vendido pra quem, causa da morte, etc)
  statusAt     DateTime?
  customFields Json?
  version      Int          @default(1) // concorrência otimista em updates
  deletedAt    DateTime?    // soft delete — nunca apagar histórico de verdade
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  healthEvents AnimalHealthEvent[]

  @@unique([tenantId, propertyId, identifier])
  @@index([tenantId])
  @@index([propertyId])
  @@index([loteId])
  @@map("animals")
}

enum HealthEventType {
  VACINACAO
  MEDICAMENTO
  EXAME
  PROCEDIMENTO
  REPRODUCAO
}

enum PregnancyStatus {
  NAO_CONFIRMADA
  CONFIRMADA
  PERDIDA
}

model AnimalHealthEvent {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  animalId          String
  animal            Animal           @relation(fields: [animalId], references: [id])
  visitId           String?          // pode ter nascido de uma visita ou ser standalone
  visit             Visit?           @relation(fields: [visitId], references: [id])
  type              HealthEventType
  description       String
  productName       String?          // vacina/medicamento aplicado
  doseInfo          String?
  appliedById       String?
  appliedBy         User?            @relation("HealthEventAppliedBy", fields: [appliedById], references: [id])
  appliedAt         DateTime
  withdrawalUntil   DateTime?        // carência — até quando não pode abater/vender
  nextDueDate       DateTime?        // próxima aplicação prevista — alimenta /health-events/upcoming
  pregnancyStatus   PregnancyStatus? // só relevante quando type = REPRODUCAO
  expectedBirthDate DateTime?        // idem
  notes             String?
  customFields      Json?
  createdAt         DateTime         @default(now())

  @@index([tenantId])
  @@index([animalId])
  @@index([tenantId, nextDueDate])
  @@index([tenantId, withdrawalUntil])
  @@map("animal_health_events")
}

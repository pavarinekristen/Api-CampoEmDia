{
  "name": "campo-em-dia",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de assistência técnica rural — monorepo (API modular monolith + workers + contracts compartilhados)",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d postgres redis minio",
    "dev:infra:down": "docker compose down",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:workers": "npm run start:dev --workspace=apps/workers",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
